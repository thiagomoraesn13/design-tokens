{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "noEmit": false,
    "allowImportingTsExtensions": false,

    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true
  },
  "include": ["src/index.ts", "src/tokens/**/*.ts"]
}
