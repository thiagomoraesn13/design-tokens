{
  "name": "@thiagomoraesn13/design-tokens",
  "version": "0.0.38",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens/*": {
      "types": "./dist/tokens/*.d.ts",
      "import": "./dist/tokens/*.js",
      "default": "./dist/tokens/*.js"
    },
    "./index.css": "./dist/index.css",
    "./utilities.css": "./dist/utilities.css",
    "./themes/noverde/index.css": "./dist/themes/noverde/index.css",
    "./themes/noverde/colors.css": "./dist/themes/noverde/colors.css",
    "./themes/dotz/index.css": "./dist/themes/dotz/index.css",
    "./themes/dotz/colors.css": "./dist/themes/dotz/colors.css"
  },
  "scripts": {
    "build:tokens-js": "tsc -p tsconfig.tokens.json",
    "build:utilities": "node scripts/gen-utilities.mjs",
    "build:entry": "tsc -p tsconfig.entry.dist.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "yarn build:tokens-js && vite build && yarn build:utilities && yarn build:entry && yarn build:types",
    "prepublishOnly": "yarn build",
    "publish:pkg": "npm publish"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "typescript": "^5.9.3",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
